<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Launch a Windows game"
            android:textColor="@color/text_primary"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Pick any .exe — your own build, GOG installer, itch.io download, or a Steam game's exe. It runs through Wine inside the Debian proot, with optional DXVK / FEX / gamescope / box86."
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="16dp"
            android:lineSpacingExtra="2dp" />

        <!-- .exe picker -->
        <LinearLayout style="@style/Card"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView style="@style/CardTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1. Pick the .exe" />

            <TextView
                android:id="@+id/exePathText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="(no file picked)"
                android:textColor="@color/accent"
                android:fontFamily="monospace"
                android:textSize="12sp"
                android:maxLines="3"
                android:ellipsize="middle"
                android:layout_marginBottom="10dp" />

            <Button
                android:id="@+id/btnPickExe"
                style="@style/PrimaryButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Pick .exe from file explorer" />
        </LinearLayout>

        <!-- Profile + flags -->
        <LinearLayout style="@style/Card"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView style="@style/CardTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2. Options" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Profile (optional, e.g. turnip-current)"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:layout_marginTop="4dp" />

            <EditText
                android:id="@+id/profileEdit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="default"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary"
                android:background="@color/bg_card_active"
                android:padding="10dp"
                android:fontFamily="monospace"
                android:textSize="13sp"
                android:singleLine="true"
                android:layout_marginBottom="10dp" />

            <CheckBox android:id="@+id/chkGamescope"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Wrap in gamescope (nested compositor, fullscreen)"
                android:textColor="@color/text_primary" />

            <CheckBox android:id="@+id/chkDxvk"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Enable DXVK (DirectX → Vulkan)"
                android:textColor="@color/text_primary"
                android:checked="true" />

            <CheckBox android:id="@+id/chkFex"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Enable FEX-Emu (x86 → ARM translation)"
                android:textColor="@color/text_primary" />

            <CheckBox android:id="@+id/chkBox86"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Enable box86 / box64 (alternative x86 emu)"
                android:textColor="@color/text_primary" />
        </LinearLayout>

        <!-- Launch -->
        <LinearLayout style="@style/Card"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView style="@style/CardTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="3. Launch" />

            <Button
                android:id="@+id/btnLaunch"
                style="@style/PrimaryButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Launch game in Termux" />

            <Button
                android:id="@+id/btnCancel"
                style="@style/SecondaryButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/cancel" />
        </LinearLayout>

        <!-- Log -->
        <LinearLayout style="@style/Card"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView style="@style/CardTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Log" />

            <TextView
                android:id="@+id/logText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:background="@color/bg_dark"
                android:padding="8dp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
