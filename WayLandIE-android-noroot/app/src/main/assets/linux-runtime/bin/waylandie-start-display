#!/bin/sh
# waylandie-start-display — connect the Linux side to the Android bridge.
#
# This script sets up the environment so that the next command the user runs
# (vkcube, weston-simple-egl, a game, Steam) will push dmabuf frames into
# the WayLandIE Android display app.
#
# It does NOT itself open a long-running process — it just exports the
# environment variables needed. After running this, run `waylandie-doctor`
# to verify, or `waylandie-run <cmd>` to actually launch a client.

set -e

# Load backend config if available.
for conf in /usr/local/share/waylandie/backend.conf \
            /usr/share/waylandie/backend.conf \
            "$HOME/.local/share/waylandie/backend.conf"; do
    if [ -f "$conf" ]; then
        . "$conf"
        break
    fi
done

SOCKET="${WAYLANDIE_BRIDGE_SOCKET:-waylandie.display.bridge.v1}"

echo "WayLandIE bridge setup"
echo "  socket   : $SOCKET"
echo "  backend  : ${WAYLANDIE_BACKEND:-unknown}"
echo "  finalcopy: ${WAYLANDIE_FINAL_COPY:-allowed}"

# Probe whether the Android app is listening on the abstract socket.
# On Linux /proc/net/unix lists abstract sockets with a leading @.
if grep -q "@${SOCKET}" /proc/net/unix 2>/dev/null; then
    echo "  bridge   : LISTENING ✓"
else
    echo "  bridge   : not listening"
    echo
    echo "Open the WayLandIE Android app and tap 'Start display', then re-run this."
    exit 1
fi

# Set the standard Wayland env vars so any wayland client picked up next
# speaks to the bridge. The WayLandIE bridge socket is a Linux abstract
# socket; Wayland's WAYLAND_DISPLAY normally maps to a file path but we
# override WAYLAND_SOCKET to point at the abstract socket instead.
export WAYLAND_DISPLAY="waylandie"
export WAYLANDIE_BRIDGE_SOCKET="$SOCKET"
export _WAYLANDIE_ACTIVE=1

# Write a small rc file that waylandie-run sources so users can also just
# `source waylandie-start-display` instead of eval'ing exports.
RC_DIR="${XDG_RUNTIME_DIR:-/tmp}/waylandie"
mkdir -p "$RC_DIR"
cat > "$RC_DIR/env.sh" <<EOF
export WAYLAND_DISPLAY="$WAYLAND_DISPLAY"
export WAYLANDIE_BRIDGE_SOCKET="$SOCKET"
export _WAYLANDIE_ACTIVE=1
EOF

echo
echo "Environment exported. Now run:"
echo "  waylandie-doctor              # verify"
echo "  waylandie-run vkcube --wsi wayland"
echo "  waylandie-run weston-simple-egl"
echo "  waylandie-steam-session start"
