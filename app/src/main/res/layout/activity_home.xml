<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textColor="@color/text_primary"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_subtitle"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:layout_marginBottom="20dp" />

        <!-- HERO CARD: pick .exe -->
        <LinearLayout style="@style/HeroCard"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Play a game"
                android:textColor="@color/text_primary"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Pick any Windows .exe from your Downloads folder. It launches through Proton via the bundled rootfs."
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="16dp" />

            <TextView
                android:id="@+id/selectedExePath"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="No game selected"
                android:textColor="@color/accent_secondary"
                android:fontFamily="monospace"
                android:textSize="12sp"
                android:maxLines="3"
                android:ellipsize="middle"
                android:background="@color/bg_dark"
                android:padding="10dp"
                android:layout_marginBottom="12dp" />

            <CheckBox android:id="@+id/chkGamescope"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Wrap in Gamescope (fullscreen compositor)"
                android:textColor="@color/text_primary"
                android:buttonTint="@color/accent" />

            <CheckBox android:id="@+id/chkUseProton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Use Armec Proton (install via Settings first)"
                android:textColor="@color/text_primary"
                android:buttonTint="@color/accent"
                android:checked="true"
                android:layout_marginBottom="14dp" />

            <Button android:id="@+id/btnPickExe"
                style="@style/HeroButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Select .exe to launch" />

            <Button android:id="@+id/btnLaunchGame"
                style="@style/HeroButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Launch game"
                android:visibility="gone" />
        </LinearLayout>

        <!-- STEAM -->
        <LinearLayout style="@style/Card"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView style="@style/CardTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Steam" />

            <Button android:id="@+id/btnLaunchSteam"
                style="@style/SteamButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Launch Steam" />
        </LinearLayout>

        <!-- SYSTEM STATUS -->
        <LinearLayout style="@style/Card"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView style="@style/CardTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="System status" />

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="6dp">
                <View android:id="@+id/bridgeStatusDot" android:layout_width="10dp" android:layout_height="10dp"
                    android:background="@color/text_tertiary" android:layout_marginEnd="8dp" />
                <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                    android:text="Bridge" android:textColor="@color/text_secondary" android:textSize="13sp" />
                <TextView android:id="@+id/bridgeStatusText" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text="@string/home_bridge_status_unknown"
                    android:textColor="@color/text_secondary" android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="6dp">
                <View android:id="@+id/controllerStatusDot" android:layout_width="10dp" android:layout_height="10dp"
                    android:background="@color/text_tertiary" android:layout_marginEnd="8dp" />
                <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                    android:text="Controller" android:textColor="@color/text_secondary" android:textSize="13sp" />
                <TextView android:id="@+id/controllerStatusText" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text="none" android:textColor="@color/text_secondary"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="6dp">
                <View android:id="@+id/audioStatusDot" android:layout_width="10dp" android:layout_height="10dp"
                    android:background="@color/text_tertiary" android:layout_marginEnd="8dp" />
                <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                    android:text="Audio" android:textColor="@color/text_secondary" android:textSize="13sp" />
                <TextView android:id="@+id/audioStatusText" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text="off — starts with game"
                    android:textColor="@color/text_secondary" android:textSize="13sp" />
            </LinearLayout>

            <TextView android:id="@+id/nativeStatusText"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="@color/text_tertiary" android:textSize="11sp"
                android:fontFamily="monospace" android:layout_marginTop="4dp" />

            <TextView android:id="@+id/envStatusText"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="@color/text_tertiary" android:textSize="11sp"
                android:fontFamily="monospace" android:layout_marginTop="2dp"
                android:text="Environment: checking…" />

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:layout_marginTop="10dp">
                <Button android:id="@+id/btnStartDisplay" style="@style/SecondaryButton"
                    android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp" android:text="@string/home_start_display" />
                <Button android:id="@+id/btnStopDisplay" style="@style/SecondaryButton"
                    android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                    android:layout_marginStart="6dp" android:text="@string/home_stop_display" />
            </LinearLayout>
        </LinearLayout>

        <!-- ACTIONS -->
        <LinearLayout style="@style/Card"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <Button android:id="@+id/btnSettings" style="@style/PrimaryButton"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Settings — Drivers &amp; Wrappers" />

            <Button android:id="@+id/btnContainers" style="@style/PrimaryButton"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="📦 Containers — Wine Desktop &amp; Shortcuts" />

            <Button android:id="@+id/btnTaskManager" style="@style/PrimaryButton"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Task Manager (running processes)" />

            <Button android:id="@+id/btnDiagnostics" style="@style/PrimaryButton"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Run Diagnostics (pre-flight check)" />

            <Button android:id="@+id/btnSaveLogs" style="@style/PrimaryButton"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Save Logs (for debugging)"
                android:background="@color/danger" />

            <Button android:id="@+id/btnAbout" style="@style/SecondaryButton"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/home_about" />
        </LinearLayout>

        <!-- LOG -->
        <LinearLayout style="@style/Card"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView style="@style/CardTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Activity log" />

            <ScrollView android:layout_width="match_parent" android:layout_height="160dp"
                android:background="@color/bg_dark">
                <TextView android:id="@+id/logText"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:fontFamily="monospace" android:padding="8dp"
                    android:textColor="@color/text_tertiary" android:textSize="11sp"
                    android:text="(no events yet)" />
            </ScrollView>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
