<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:orientation="vertical"
    android:gravity="top|center_horizontal"
    android:padding="32dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="WayLandIE"
        android:textColor="@color/accent"
        android:textSize="32sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp"
        android:layout_marginTop="20dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Zero-copy Windows games on Android"
        android:textColor="@color/text_secondary"
        android:textSize="14sp"
        android:layout_marginBottom="32dp" />

    <ProgressBar
        android:id="@+id/progressBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:max="100"
        android:progress="0"
        android:layout_marginBottom="12dp" />

    <TextView
        android:id="@+id/statusText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Initializing…"
        android:textColor="@color/text_primary"
        android:textSize="16sp"
        android:layout_marginBottom="6dp" />

    <TextView
        android:id="@+id/percentText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="0%"
        android:textColor="@color/text_secondary"
        android:textSize="14sp"
        android:fontFamily="monospace"
        android:layout_marginBottom="16dp" />

    <!-- Activity log — restored 2026-06-19.
         Previously this screen had NO log TextView, which is why the
         user reported "first page no longer shows log". The log is a
         release-build feature, not a debug toggle: it is the user's
         only signal that setup is healthy.

         Reference pattern: HomeActivity.java:208 already had this
         TextView in activity_home.xml — the initializer layout had
         lost it during a refactor. We restore it here as a ScrollView
         with layout_weight=1 so it fills the available vertical space
         between the percentText and the buttons. -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Activity log"
        android:textColor="@color/text_secondary"
        android:textSize="12sp"
        android:layout_marginBottom="4dp"
        android:layout_gravity="start" />

    <ScrollView
        android:id="@+id/logScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/bg_dark"
        android:fillViewport="true"
        android:layout_marginBottom="16dp">

        <TextView
            android:id="@+id/logText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:padding="8dp"
            android:textColor="@color/text_tertiary"
            android:textSize="11sp"
            android:text="(no events yet)" />
    </ScrollView>

    <Button
        android:id="@+id/btnContinue"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Continue"
        android:background="@color/accent"
        android:textColor="@color/text_primary"
        android:padding="16dp"
        android:visibility="gone" />

    <Button
        android:id="@+id/btnRetry"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Retry"
        android:background="@color/accent"
        android:textColor="@color/text_primary"
        android:padding="16dp"
        android:visibility="gone" />

    <Button
        android:id="@+id/btnSaveLogs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Save Logs (for debugging)"
        android:background="@color/danger"
        android:textColor="@color/text_primary"
        android:padding="16dp"
        android:visibility="gone" />

    <Button
        android:id="@+id/btnSkip"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Skip — go to Home anyway"
        android:background="@color/bg_card_active"
        android:textColor="@color/text_secondary"
        android:padding="16dp"
        android:visibility="gone" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="This happens once. Next launch will be instant."
        android:textColor="@color/text_tertiary"
        android:textSize="11sp"
        android:layout_marginTop="16dp" />

</LinearLayout>
