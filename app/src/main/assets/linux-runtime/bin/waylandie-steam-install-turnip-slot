#!/bin/sh
# waylandie-steam-install-turnip-slot — install a custom Mesa Turnip build
# (Adreno Vulkan ICD) into a named slot.
#
# Usage:
#   waylandie-steam-install-turnip-slot --appid 287390 --slot test-turnip --activate path/to/turnip.tar.gz

set -e
APPID=""
SLOT=""
ARCHIVE=""
ACTIVATE=false

while [ $# -gt 0 ]; do
    case "$1" in
        --appid) APPID="$2"; shift 2 ;;
        --slot)  SLOT="$2";  shift 2 ;;
        --activate) ARCHIVE="$2"; ACTIVATE=true; shift 2 ;;
        *) echo "unknown arg: $1" >&2; exit 2 ;;
    esac
done

[ -z "$APPID" ] && { echo "--appid required" >&2; exit 2; }
[ -z "$SLOT" ]  && { echo "--slot required"  >&2; exit 2; }
[ -z "$ARCHIVE" ] && { echo "--activate FILE required" >&2; exit 2; }

ROOT="${XDG_DATA_HOME:-$HOME/.local/share}/waylandie/steam-profiles/$APPID/turnip/$SLOT"
mkdir -p "$ROOT"
tar -xzf "$ARCHIVE" -C "$ROOT" 2>/dev/null || tar -xf "$ARCHIVE" -C "$ROOT" 2>/dev/null || unzip -q "$ARCHIVE" -d "$ROOT"
echo "installed Turnip slot '$SLOT' for AppID $APPID → $ROOT"

# Find the ICD JSON inside the slot.
ICD=$(find "$ROOT" -name "*icd*.json" -type f 2>/dev/null | head -1)
if [ -n "$ICD" ]; then
    echo "ICD JSON: $ICD"
    if [ "$ACTIVATE" = "true" ]; then
        echo "to activate, add to Steam Launch Options:"
        echo "  VK_ICD_FILENAMES=$ICD %command%"
    fi
else
    echo "WARNING: no ICD JSON found in slot. Activate manually."
fi
