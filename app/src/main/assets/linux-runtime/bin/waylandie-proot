#!/data/data/com.termux/files/usr/bin/sh
# waylandie-proot — wrapper around `proot-distro login debian` that adds
# the bind mounts needed for hardware GPU acceleration via KGSL.
#
# The standard Turnip driver (from K11MCH1/AdrenoToolsDrivers) is the
# "standalone" build — it links against Android's libhardware.so and
# libsync.so, which means binding /system/lib64 into the proot is
# required. But that triggers a Bionic linker conflict (proot's glibc
# vs Android's bionic both define pthread_atfork, __cxa_atexit, etc.
# with different ABIs) and crashes with SIGTRAP "Trace/breakpoint trap".
#
# The fix is to use the **KGSL variant** of Turnip (mesa-vulkan-kgsl)
# which links against proot's own glibc and talks directly to
# /dev/kgsl-3d0 via ioctl. No Android framework libraries needed.
#
# This wrapper binds /dev/kgsl-3d0 (and related device nodes) into the
# proot so the KGSL driver can access the GPU directly. It does NOT
# bind /system/lib64 or /vendor/lib64 — those cause the Bionic crash.
#
# Usage:
#   waylandie-proot -- bash                # interactive shell
#   waylandie-proot -- bash -lc 'waylandie-doctor'
#   waylandie-proot -- waylandie-steam-session start
#
# All args after `--` are passed to proot-distro.

PROOT_DISTRO=/data/data/com.termux/files/usr/bin/proot-distro

# KGSL device nodes — present on all Qualcomm Adreno devices.
# /dev/kgsl-3d0 is the main 3D GPU device.
# /dev/kgsl-3d0-cxt is the context bank (some kernels).
# /dev/dri/renderD128 is the DRM render node (Mesa may use it).
BIND_ARGS=""
for dev in /dev/kgsl-3d0 /dev/kgsl-3d0-cxt /dev/dri /dev/dri/renderD128 /dev/ion /dev/mali0; do
    if [ -e "$dev" ]; then
        BIND_ARGS="$BIND_ARGS --bind $dev:$dev"
    fi
done

# /dev/property_contexts and /vendor/etc/selinux — needed for some
# Qualcomm-specific ioctls. Bind read-only.
for syspath in /vendor/etc/selinux /vendor/etc/init /vendor/etc/vintf; do
    if [ -e "$syspath" ]; then
        BIND_ARGS="$BIND_ARGS --bind $syspath:$syspath:ro"
    fi
done

# Property buffer — some KGSL builds read ro.hardware.* properties.
# Bind /dev/__properties__ if present (Android property files).
for prop in /dev/__properties__; do
    if [ -e "$prop" ]; then
        BIND_ARGS="$BIND_ARGS --bind $prop:$prop"
    fi
done

exec "$PROOT_DISTRO" login debian --shared-tmp $BIND_ARGS "$@"
