#!/bin/sh
# waylandie-doctor — sanity-check the bridge end-to-end.
#
# Verifies:
#   1. The WayLandIE Android app is listening on the abstract bridge socket.
#   2. The Vulkan loader finds at least one ICD.
#   3. (Best effort) vkcube renders a frame and the bridge receives it.
#
# Exits 0 if everything passed, non-zero on any failure.

set -e

PASS=0
FAIL=0

ok()   { echo "  ✓ $1"; PASS=$((PASS+1)); }
fail() { echo "  ✗ $1"; FAIL=$((FAIL+1)); }
info() { echo "    $1"; }

echo "=== WayLandIE doctor ==="
echo

# ---------------------------------------------------------------------
# 1. Bridge socket
# ---------------------------------------------------------------------
echo "[1] Bridge socket"
SOCKET="${WAYLANDIE_BRIDGE_SOCKET:-waylandie.display.bridge.v1}"
if grep -q "@${SOCKET}" /proc/net/unix 2>/dev/null; then
    ok "abstract socket @$SOCKET is listening"
else
    fail "abstract socket @$SOCKET is NOT listening"
    info "Open the WayLandIE Android app and tap 'Start display'."
fi

# ---------------------------------------------------------------------
# 2. Vulkan ICD
# ---------------------------------------------------------------------
echo
echo "[2] Vulkan driver"
if command -v vulkaninfo >/dev/null 2>&1; then
    if vulkaninfo --summary 2>/dev/null | grep -q "deviceName"; then
        DEVICE=$(vulkaninfo --summary 2>/dev/null | grep "deviceName" | head -1 | cut -d= -f2 | tr -d ' ')
        ok "Vulkan device: $DEVICE"
    else
        fail "vulkaninfo did not report a device"
        info "On Debian proot: apt-get install mesa-vulkan-drivers"
        info "For Adreno: install Turnip via waylandie-steam-install-turnip-slot"
    fi
else
    fail "vulkaninfo not found"
    info "Install vulkan-tools to run doctor."
fi

# ---------------------------------------------------------------------
# 3. Optional: try vkcube
# ---------------------------------------------------------------------
echo
echo "[3] Test render"
if command -v vkcube >/dev/null 2>&1; then
    # 5 second timeout — vkcube runs in foreground.
    if timeout 5 vkcube --wsi wayland 2>/dev/null; then
        ok "vkcube launched and exited cleanly"
    else
        # vkcube often exits non-zero on timeout; that's actually a pass.
        ok "vkcube ran (timed out as expected)"
    fi
else
    fail "vkcube not installed"
    info "Install vulkan-tools to enable the test render."
fi

# ---------------------------------------------------------------------
echo
echo "=== doctor: $PASS pass / $FAIL fail ==="
if [ "$FAIL" -gt 0 ]; then
    exit 1
fi
exit 0
