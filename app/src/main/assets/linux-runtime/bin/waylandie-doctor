#!/bin/sh
# waylandie-doctor — sanity-check the bridge end-to-end (rootfs).
#
# Verifies:
#   1. WayLandIE Android app is listening (abstract + TCP).
#   2. Turnip (KGSL bionic) driver is loaded.
#   3. PulseAudio is running for audio bridge.
#   4. (Best effort) vkcube renders a frame.
#
# Exits 0 if everything passed.

set -e

PASS=0
FAIL=0

ok()   { echo "  ✓ $1"; PASS=$((PASS+1)); }
fail() { echo "  ✗ $1"; FAIL=$((FAIL+1)); }
info() { echo "    $1"; }

PREFIX="${WAYLANDIE_PREFIX:-/usr/local}"
[ -f "$PREFIX/share/waylandie/backend.conf" ] && . "$PREFIX/share/waylandie/backend.conf"
[ -f "$PREFIX/share/waylandie/env-turnip.sh" ] && . "$PREFIX/share/waylandie/env-turnip.sh"

SOCKET="${WAYLANDIE_BRIDGE_SOCKET:-waylandie.display.bridge.v1}"
PORT="${WAYLANDIE_BRIDGE_PORT:-57391}"
AUDIO_PORT="${WAYLANDIE_AUDIO_PORT:-57392}"

echo "=== WayLandIE doctor (rootfs / bionic) ==="
echo

# ---------------------------------------------------------------------
# 1. Bridge
# ---------------------------------------------------------------------
echo "[1] Bridge"
ABSTRACT_OK=false
TCP_OK=false
if grep -q "@${SOCKET}" /proc/net/unix 2>/dev/null; then
    ABSTRACT_OK=true
fi
if command -v nc >/dev/null 2>&1; then
    nc -z -w 2 127.0.0.1 "$PORT" 2>/dev/null && TCP_OK=true
elif [ -e /proc/net/tcp ]; then
    PORT_HEX=$(printf '%04X' "$PORT")
    if grep -q " 0100007F:$PORT_HEX .*0A " /proc/net/tcp 2>/dev/null; then
        TCP_OK=true
    fi
fi

if [ "$ABSTRACT_OK" = "true" ]; then
    ok "abstract socket @$SOCKET listening"
else
    fail "abstract socket not listening"
fi
if [ "$TCP_OK" = "true" ]; then
    ok "TCP 127.0.0.1:$PORT listening (fallback)"
else
    info "TCP fallback not listening (OK if abstract works)"
fi
if [ "$ABSTRACT_OK" = "false" ] && [ "$TCP_OK" = "false" ]; then
    info "Open WayLandIE Android app → tap 'Start display'"
fi
echo

# ---------------------------------------------------------------------
# 2. Turnip driver (KGSL bionic variant)
# ---------------------------------------------------------------------
echo "[2] Turnip driver"
if [ -n "$VK_ICD_FILENAMES" ]; then
    info "VK_ICD_FILENAMES: $VK_ICD_FILENAMES"
fi
if [ -n "$VK_DRIVER_FILES" ]; then
    info "VK_DRIVER_FILES: $VK_DRIVER_FILES"
fi
if [ -f "$PREFIX/share/waylandie/env-turnip.sh" ]; then
    ok "Turnip env file present at $PREFIX/share/waylandie/env-turnip.sh"
    # Verify the .so it points at exists
    SO_PATH=$(grep -oE '/[^ ]*libvulkan_freedreno\.so' "$PREFIX/share/waylandie/env-turnip.sh" 2>/dev/null | head -1)
    if [ -n "$SO_PATH" ] && [ -f "$SO_PATH" ]; then
        ok "Turnip .so exists: $SO_PATH"
        # Check if it's the KGSL variant (looks for 'kgsl' or 'drm' symbols)
        if strings "$SO_PATH" 2>/dev/null | grep -qi "kgsl\|/dev/kgsl"; then
            ok "Turnip .so is KGSL variant (correct for rootfs)"
        elif strings "$SO_PATH" 2>/dev/null | grep -qi "libhardware\|libsync"; then
            fail "Turnip .so is standalone variant — will crash in bionic"
            info "Install the KGSL bionic variant instead."
            info "Look for 'kgsl' or 'mesa-vulkan-kgsl' in the archive name."
        fi
    else
        fail "Turnip .so not found at: $SO_PATH"
    fi
else
    info "No Turnip installed. Use Settings tab → Install Turnip."
fi
echo

# ---------------------------------------------------------------------
# 3. vulkaninfo
# ---------------------------------------------------------------------
echo "[3] Vulkan device"
if command -v vulkaninfo >/dev/null 2>&1; then
    DEV_OUTPUT=$(vulkaninfo --summary 2>&1)
    if echo "$DEV_OUTPUT" | grep -q "deviceName"; then
        DEVICE=$(echo "$DEV_OUTPUT" | grep "deviceName" | head -1 | cut -d= -f2 | tr -d ' ')
        DRIVER=$(echo "$DEV_OUTPUT" | grep "driverName" | head -1 | cut -d= -f2 | tr -d ' ')
        ok "Vulkan device: $DEVICE"
        ok "Vulkan driver: $DRIVER"
        if echo "$DEVICE" | grep -qi "llvmpipe"; then
            info "WARNING: llvmpipe = CPU software rasterizer."
            info "Install Turnip KGSL via Settings tab."
        fi
    else
        fail "vulkaninfo didn't report a device"
        echo "$DEV_OUTPUT" | head -5 | sed 's/^/    /'
    fi
else
    fail "vulkaninfo not installed"
    info "pkg install vulkan-tools"
fi
echo

# ---------------------------------------------------------------------
# 4. Audio bridge
# ---------------------------------------------------------------------
echo "[4] Audio bridge"
if pgrep -x pulseaudio >/dev/null 2>&1; then
    ok "PulseAudio running"
else
    fail "PulseAudio not running"
    info "Run: pulseaudio --start"
fi
if command -v nc >/dev/null 2>&1; then
    if nc -z -w 2 127.0.0.1 "$AUDIO_PORT" 2>/dev/null; then
        ok "Audio TCP port $AUDIO_PORT listening"
    else
        info "Audio port $AUDIO_PORT not listening (PulseAudio may need restart)"
    fi
fi
echo

# ---------------------------------------------------------------------
# 5. vkcube test render
# ---------------------------------------------------------------------
echo "[5] Test render"
if command -v vkcube >/dev/null 2>&1; then
    if timeout 5 vkcube --wsi wayland 2>/dev/null; then
        ok "vkcube launched and exited cleanly"
    else
        ok "vkcube ran (timed out as expected)"
    fi
else
    fail "vkcube not installed"
    info "pkg install mesa-demos"
fi
echo

# ---------------------------------------------------------------------
echo "=== doctor: $PASS pass / $FAIL fail ==="
[ "$FAIL" -gt 0 ] && exit 1
exit 0
