#!/bin/sh
# waylandie-diagnose — captures every relevant log + state, then uploads
# the bundle so the developer can see exactly what's happening.
#
# Usage (from Termux, NOT proot):
#   sh /sdcard/Download/WayLandIE/linux-runtime/bin/waylandie-diagnose
#
# Or one-liner:
#   curl -sL https://tmpfiles.org/dl/<uploaded-by-developer> | sh
#
# Output: a single URL you paste back to the developer.

set +e
OUT=/tmp/waylandie-diag.txt
> "$OUT"

log() { echo "$@" | tee -a "$OUT"; }

log "=== WayLandIE Diagnostic Bundle ==="
log "Generated: $(date)"
log "============================================================"
log

# ----- Device info -----
log "## Device info"
log "Android: $(getprop ro.build.version.release 2>/dev/null)"
log "Device:  $(getprop ro.product.model 2>/dev/null) ($(getprop ro.product.device 2>/dev/null))"
log "SoC:     $(getprop ro.soc.manufacturer 2>/dev/null) $(getprop ro.soc.model 2>/dev/null)"
log "ABI:     $(getprop ro.product.cpu.abi 2>/dev/null)"
log "Kernel:  $(uname -a)"
log "Termux:  $(dpkg -l 2>/dev/null | grep '^ii.*com.termux' | awk '{print $3}')"
log

# ----- WayLandIE app -----
log "## WayLandIE app"
APK_DIR=$(pm path io.waylandie.display 2>/dev/null | head -1 | sed 's/package://')
if [ -n "$APK_DIR" ]; then
    log "Installed: yes ($APK_DIR)"
    log "Version:   $(dumpsys package io.waylandie.display 2>/dev/null | grep versionName | head -1 | sed 's/.*=//')"
else
    log "Installed: NO"
fi
log

# ----- App process state -----
log "## App process state"
log "PID: $(pgrep -f io.waylandie.display 2>/dev/null || echo 'not running')"
log "Foreground service notification present?"
log "$(dumpsys notification 2>/dev/null | grep -A2 'Wayland bridge' | head -10)"
log

# ----- Bridge sockets (Android-side view — should see them) -----
log "## Bridge sockets (Android side via /proc/net/unix)"
log "Abstract socket @waylandie.display.bridge.v1:"
log "$(grep 'waylandie.display.bridge' /proc/net/unix 2>/dev/null || echo '  NOT FOUND')"
log
log "TCP port 57391 listening?"
log "$(ss -tlnp 2>/dev/null | grep 57391 || netstat -tlnp 2>/dev/null | grep 57391 || echo '  NOT FOUND')"
log

# ----- WayLandIE logcat (last 100 lines from app) -----
log "## WayLandIE logcat (last 100 lines)"
log "------------------------------------------------------------"
logcat -d -t 200 2>/dev/null | grep -iE 'waylandie|WayLandIEDisplay|WayLandIEBridge|AndroidRuntime.*io.waylandie' | tail -100 >> "$OUT"
log "------------------------------------------------------------"
log

# ----- logcat if app crashed -----
log "## Recent crashes (last 5 hours)"
log "------------------------------------------------------------"
logcat -d -t 36000 2>/dev/null | grep -iE 'FATAL|AndroidRuntime.*io.waylandie' | tail -50 >> "$OUT"
log "------------------------------------------------------------"
log

# ----- Termux info -----
log "## Termux"
log "Termux package: $(pm path com.termux 2>/dev/null || echo 'NOT INSTALLED')"
log "Termux:API:     $(pm path com.termux.api 2>/dev/null || echo 'NOT INSTALLED')"
log "Termux prefs:"
log "$(cat ~/.termux/termux.properties 2>/dev/null | grep -v '^#' | grep -v '^$' || echo '  (no user prefs file, defaults used)')"
log

# ----- proot-distro info -----
log "## proot-distro"
log "Installed distros:"
log "$(proot-distro list 2>/dev/null | grep -A1 'Installed' | tail -5 || echo '  proot-distro not found')"
log

# ----- Debian-side state (via proot login) -----
log "## Debian proot state"
log "------------------------------------------------------------"
proot-distro login debian --shared-tmp -- bash -lc '
echo "### Debian version:"
cat /etc/os-release | head -3
echo
echo "### Kernel uname:"
uname -a
echo
echo "### Vulkan ICD search dirs:"
ls -la /usr/share/vulkan/icd.d/ 2>/dev/null || echo "  (no /usr/share/vulkan/icd.d/)"
ls -la /etc/vulkan/icd.d/ 2>/dev/null || echo "  (no /etc/vulkan/icd.d/)"
ls -la /usr/local/etc/vulkan/icd.d/ 2>/dev/null || echo "  (no /usr/local/etc/vulkan/icd.d/)"
echo
echo "### ICD JSON contents:"
for f in /usr/share/vulkan/icd.d/*.json /etc/vulkan/icd.d/*.json /usr/local/etc/vulkan/icd.d/*.json; do
    [ -f "$f" ] && echo "--- $f ---" && cat "$f" && echo
done
echo
echo "### WayLandIE driver slots:"
find /root/.local/share/waylandie/driver-slots/ -type f 2>/dev/null | head -20 || echo "  (none)"
echo
echo "### WayLandIE env-turnip.sh:"
cat /usr/local/share/waylandie/env-turnip.sh 2>/dev/null || echo "  (not found)"
echo
echo "### Installed waylandie scripts:"
ls -la /usr/local/bin/waylandie-* 2>/dev/null
echo
echo "### vulkaninfo summary:"
vulkaninfo --summary 2>&1 | head -40 || echo "  vulkaninfo not installed"
echo
echo "### Bridge probes from inside proot:"
echo "  /proc/net/unix waylandie entries:"
grep waylandie /proc/net/unix 2>/dev/null || echo "    (none — expected in proot)"
echo
echo "  /proc/net/tcp port 57391 (hex E23F) LISTEN entries:"
PORT_HEX=$(printf "%04X" 57391)
grep " 0100007F:$PORT_HEX " /proc/net/tcp 2>/dev/null || echo "    (not listening)"
echo
echo "  Direct TCP test:"
(echo > /dev/tcp/127.0.0.1/57391) 2>&1 | head -2 && echo "    TCP OPEN" || echo "    TCP CLOSED/unreachable"
echo
echo "### FEX-Emu installed?"
command -v FEXLoader && FEXLoader --version 2>&1 | head -2 || echo "  FEX not on PATH"
ls -la /opt/fex 2>/dev/null | head -5 || echo "  no /opt/fex"
' >> "$OUT" 2>&1
log "------------------------------------------------------------"
log

# ----- Final summary -----
log "## Bundle size"
log "$(wc -l < "$OUT") lines, $(wc -c < "$OUT") bytes"
log

# ----- Upload -----
echo "Uploading diagnostic bundle to tmpfiles.org…" >&2
UPLOAD=$(curl -sS -F "file=@$OUT" https://tmpfiles.org/api/v1/upload 2>&1)
URL=$(echo "$UPLOAD" | grep -oE 'https://tmpfiles.org/[a-zA-Z0-9/_.-]+' | head -1)
if [ -n "$URL" ]; then
    DL_URL=$(echo "$URL" | sed 's|tmpfiles.org/|tmpfiles.org/dl/|')
    echo
    echo "============================================================"
    echo "✓ Uploaded successfully"
    echo
    echo "PASTE THIS URL to the developer:"
    echo
    echo "  $DL_URL"
    echo
    echo "============================================================"
    echo
    echo "Local copy: $OUT"
else
    echo
    echo "Upload failed. Response was: $UPLOAD"
    echo
    echo "Local copy of diagnostic bundle: $OUT"
    echo "Paste the contents of that file to the developer manually."
fi
