#!/bin/sh
# waylandie-steam-session — manage Steam ARM64 + FEX in Termux-native (bionic).
#
# No proot, no Debian. Steam runs directly in Termux. Per-game
# containerization (pressure-vessel + bubblewrap) does NOT work in
# Termux-native because Termux can't create unprivileged user
# namespaces either — so we force STEAM_RUNTIME=0.
#
# For Armec Proton integration, install Armec Proton via Settings tab
# and pass --use-proton to steam games via Launch Options, OR set
# STEAM_COMPAT_CLIENT_INSTALL_PATH + STEAM_COMPAT_DATA_PATH before steam.
#
# Subcommands:
#   start    — start Steam under WayLandIE bridge
#   stop     — kill the running session
#   status   — show whether the session is running
#   restart  — stop then start

set -e

ACTION="${1:-status}"
shift 2>/dev/null || true

RUNTIME="0"
GAMESCOPE=false
BIG_PICTURE=true
EXTRA_ARGS=""

while [ $# -gt 0 ]; do
    case "$1" in
        --runtime=*)    RUNTIME="${1#--runtime=}"; shift ;;
        --gamescope)    GAMESCOPE=true; shift ;;
        --no-gamescope) GAMESCOPE=false; shift ;;
        --no-bigpicture) BIG_PICTURE=false; shift ;;
        --bigpicture)   BIG_PICTURE=true; shift ;;
        --*)            EXTRA_ARGS="$EXTRA_ARGS $1"; shift ;;
        *)              EXTRA_ARGS="$EXTRA_ARGS $1"; shift ;;
    esac
done

PREFIX="${WAYLANDIE_PREFIX:-/data/data/com.termux/files/usr}"
SESSION_DIR="${XDG_RUNTIME_DIR:-$PREFIX/tmp}/waylandie"
SESSION_PID_FILE="$SESSION_DIR/steam-session.pid"
SESSION_LOG_FILE="$SESSION_DIR/steam-session.log"
mkdir -p "$SESSION_DIR"

# Source env
[ -f "$SESSION_DIR/env.sh" ] && . "$SESSION_DIR/env.sh"
for envfile in env-turnip.sh env-dxvk.sh env-proton.sh env-fex.sh; do
    [ -f "$PREFIX/share/waylandie/$envfile" ] && . "$PREFIX/share/waylandie/$envfile"
done

case "$ACTION" in
    start)
        if [ -f "$SESSION_PID_FILE" ] && kill -0 "$(cat "$SESSION_PID_FILE")" 2>/dev/null; then
            echo "Steam session already running (pid $(cat "$SESSION_PID_FILE"))"
            exit 0
        fi

        # Force STEAM_RUNTIME=0 — pressure-vessel won't work in Termux
        case "$RUNTIME" in
            0|host)  export STEAM_RUNTIME=0; export STEAM_RUNTIME_PREFER_HOST_LIBS=1 ;;
            scout)   export STEAM_RUNTIME=scout; export STEAM_RUNTIME_PREFER_HOST_LIBS=1 ;;
            *)
                echo "ERROR: runtime '$RUNTIME' uses pressure-vessel (not supported in Termux)" >&2
                echo "Use --runtime=0 (default) or --runtime=scout" >&2
                exit 1
                ;;
        esac

        # Locate steam
        STEAM_BIN=""
        for c in steam steam-launcher; do
            if command -v "$c" >/dev/null 2>&1; then
                STEAM_BIN="$c"
                break
            fi
        done
        if [ -z "$STEAM_BIN" ]; then
            echo "ERROR: steam not found in Termux." >&2
            echo "  Install Steam ARM64 client from repo.steampowered.com" >&2
            echo "  or via box86 + Steam Linux i386 build." >&2
            exit 1
        fi

        # Armec Proton env (if installed)
        if [ -n "$WAYLANDIE_PROTON_DIR" ]; then
            export STEAM_COMPAT_CLIENT_INSTALL_PATH="${STEAM_COMPAT_CLIENT_INSTALL_PATH:-$HOME/.local/share/Steam}"
            echo "Armec Proton: $WAYLANDIE_PROTON_DIR"
        fi

        # FEX-Emu env (if installed)
        if [ -n "$FEX_ROOT" ]; then
            echo "FEX-Emu: $FEX_ROOT"
        fi

        # Audio env — games get PULSE_SERVER pointing at our local PulseAudio
        export PULSE_SERVER="tcp:127.0.0.1:${WAYLANDIE_AUDIO_PORT:-57392}"

        # Big Picture
        BP_FLAG=""
        [ "$BIG_PICTURE" = "true" ] && BP_FLAG="-bigpicture"

        # Gamescope
        GAMESCOPE_PREFIX=""
        if [ "$GAMESCOPE" = "true" ] && command -v gamescope >/dev/null 2>&1; then
            GAMESCOPE_PREFIX="gamescope -W 1280 -H 720 -r 60 --"
            echo "gamescope enabled"
        elif [ "$GAMESCOPE" = "true" ]; then
            echo "WARNING: gamescope not installed" >&2
        fi

        echo "Starting Steam session…"
        echo "  steam    : $STEAM_BIN"
        echo "  runtime  : $RUNTIME (no container)"
        echo "  bigpic   : $BIG_PICTURE"
        echo "  gamescope: $GAMESCOPE"
        echo "  socket   : ${WAYLANDIE_BRIDGE_SOCKET:-waylandie.display.bridge.v1}"
        echo "  audio    : $PULSE_SERVER"
        echo "  log      : $SESSION_LOG_FILE"

        (
            # shellcheck disable=SC2086
            $GAMESCOPE_PREFIX $STEAM_BIN $BP_FLAG $EXTRA_ARGS
        ) >"$SESSION_LOG_FILE" 2>&1 &
        echo $! > "$SESSION_PID_FILE"
        echo "Steam session started (pid $(cat "$SESSION_PID_FILE"))"
        echo "Tail log: tail -f $SESSION_LOG_FILE"
        ;;

    stop)
        if [ -f "$SESSION_PID_FILE" ]; then
            PID=$(cat "$SESSION_PID_FILE")
            if kill -0 "$PID" 2>/dev/null; then
                pkill -P "$PID" 2>/dev/null || true
                kill "$PID" || true
                sleep 1
                kill -9 "$PID" 2>/dev/null || true
                echo "Steam session stopped (pid $PID)"
            fi
            rm -f "$SESSION_PID_FILE"
        else
            echo "No Steam session pidfile."
        fi
        ;;

    status)
        if [ -f "$SESSION_PID_FILE" ] && kill -0 "$(cat "$SESSION_PID_FILE")" 2>/dev/null; then
            echo "status=running pid=$(cat "$SESSION_PID_FILE")"
            echo "log=$SESSION_LOG_FILE"
        else
            echo "status=stopped"
        fi
        ;;

    restart)
        "$0" stop || true
        "$0" start "$@"
        ;;

    *)
        echo "usage: $0 {start|stop|status|restart} [--runtime=0|scout] [--gamescope] [--no-bigpicture]" >&2
        exit 2
        ;;
esac
