#!/bin/sh
# waylandie-run — wrap a command with the WayLandIE environment set up.
# Termux-native (bionic). No proot.
#
# Usage:
#   waylandie-run vkcube --wsi wayland
#   waylandie-run weston-simple-egl

PREFIX="${WAYLANDIE_PREFIX:-/data/data/com.termux/files/usr}"

RC_DIR="${XDG_RUNTIME_DIR:-$PREFIX/tmp}/waylandie"
if [ -f "$RC_DIR/env.sh" ]; then
    . "$RC_DIR/env.sh"
else
    echo "waylandie-run: env not initialized, running waylandie-start-display…" >&2
    "$PREFIX/bin/waylandie-start-display" || true
    [ -f "$RC_DIR/env.sh" ] && . "$RC_DIR/env.sh"
fi

if [ $# -eq 0 ]; then
    echo "waylandie-run: no command given" >&2
    exit 1
fi

# Source driver env files if present
for envfile in env-turnip.sh env-dxvk.sh env-proton.sh env-fex.sh; do
    if [ -f "$PREFIX/share/waylandie/$envfile" ]; then
        . "$PREFIX/share/waylandie/$envfile"
    fi
done

# Zero-copy + perf hints
export WAYLANDIE_FINAL_COPY="${WAYLANDIE_FINAL_COPY:-forbidden}"
export MESA_VK_WSI_PRESENT_MODE="${MESA_VK_WSI_PRESENT_MODE:-immediate}"
export RADV_PERFTEST="${RADV_PERFTEST:-nooverflow}"

exec "$@"
