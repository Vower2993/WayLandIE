#!/bin/bash
# waylandie-run-game — run a Windows .exe through Wine inside the Debian
# proot, with optional gamescope + DXVK + FEX + box86/box64 + driver slot.
#
# Usage:
#   waylandie-run-game --exe PATH [options]
#
# Options:
#   --exe PATH         Path to the .exe (required). May be:
#                        /sdcard/Download/.../game.exe
#                        ~/storage/downloads/.../game.exe
#                        /home/user/games/game.exe
#   --profile NAME     Driver slot profile to activate (e.g. turnip-current).
#                      Default: 'default'.
#   --gamescope        Wrap in gamescope (nested compositor, fullscreen).
#   --dxvk             Override DXVK with the slot's DXVK. (Default: on if
#                      any DXVK slot is installed.)
#   --no-dxvk          Force DXVK off.
#   --fex              Enable FEX-Emu for x86 .exe on arm64 host.
#   --box86            Enable box86 (alternative x86 emulator).
#   --box64            Enable box64 (alternative x86_64 emulator).
#   --wine PATH        Wine binary to use (default: auto-detect).
#   --prefix PATH      WINEPREFIX to use (default: ~/.local/share/waylandie/wine).
#   -- ARGS            Everything after -- is passed to wine verbatim.
#
# Environment (set by waylandie-start-display):
#   WAYLANDIE_BRIDGE_SOCKET, WAYLAND_DISPLAY
#
# Example:
#   waylandie-run-game --exe /sdcard/Download/CaveStory.exe --gamescope --dxvk

set -e

EXE=""
PROFILE="default"
GAMESCOPE=false
DXVK=""
FEX=false
BOX86=false
BOX64=false
WINE_BIN=""
WINEPREFIX_DIR="$HOME/.local/share/waylandie/wine"
EXTRA_ARGS=()

# ---------------------------------------------------------------------
# Parse args
# ---------------------------------------------------------------------
while [ $# -gt 0 ]; do
    case "$1" in
        --exe)      EXE="$2"; shift 2 ;;
        --profile)  PROFILE="$2"; shift 2 ;;
        --gamescope) GAMESCOPE=true; shift ;;
        --dxvk)     DXVK=on;  shift ;;
        --no-dxvk)  DXVK=off; shift ;;
        --fex)      FEX=true; shift ;;
        --box86)    BOX86=true; shift ;;
        --box64)    BOX64=true; shift ;;
        --wine)     WINE_BIN="$2"; shift 2 ;;
        --prefix)   WINEPREFIX_DIR="$2"; shift 2 ;;
        --)         shift; EXTRA_ARGS+=("$@"); break ;;
        *)          EXTRA_ARGS+=("$1"); shift ;;
    esac
done

if [ -z "$EXE" ]; then
    echo "ERROR: --exe is required" >&2
    exit 2
fi

# Resolve EXE — allow /sdcard/... and ~/storage/downloads/... forms.
case "$EXE" in
    /sdcard/*)        REAL_EXE="/sdcard${EXE#/sdcard}" ;;
    ~/storage/*)      REAL_EXE="$HOME/storage${EXE#~/storage}" ;;
    ~/*)              REAL_EXE="$HOME${EXE#~}" ;;
    *)                REAL_EXE="$EXE" ;;
esac

if [ ! -f "$REAL_EXE" ]; then
    echo "ERROR: file not found: $REAL_EXE" >&2
    exit 1
fi

# ---------------------------------------------------------------------
# Source the WaylandIE env if not already set up.
# ---------------------------------------------------------------------
if [ -z "$WAYLANDIE_BRIDGE_SOCKET" ]; then
    if [ -f "${XDG_RUNTIME_DIR:-/tmp}/waylandie/env.sh" ]; then
        . "${XDG_RUNTIME_DIR:-/tmp}/waylandie/env.sh"
    else
        echo "WARNING: bridge env not initialized. Run waylandie-start-display first." >&2
    fi
fi

# Force zero-copy path on the bridge side.
export WAYLANDIE_FINAL_COPY="${WAYLANDIE_FINAL_COPY:-forbidden}"

# Mesa Turnip + present mode hints.
export MESA_VK_WSI_PRESENT_MODE="${MESA_VK_WSI_PRESENT_MODE:-immediate}"
export RADV_PERFTEST="${RADV_PERFTEST:-nooverflow}"

# ---------------------------------------------------------------------
# Detect wine binary.
# ---------------------------------------------------------------------
if [ -z "$WINE_BIN" ]; then
    for c in wine wine64 wine-stable wine-devel; do
        if command -v "$c" >/dev/null 2>&1; then
            WINE_BIN="$c"
            break
        fi
    done
fi
if [ -z "$WINE_BIN" ]; then
    echo "ERROR: wine not found. Install wine inside the Debian proot." >&2
    echo "  On arm64: apt-get install wine-box86 wine || apt-get install wine64" >&2
    exit 1
fi

# ---------------------------------------------------------------------
# Load driver slot profile if any.
# ---------------------------------------------------------------------
PROFILES_ROOT="${XDG_DATA_HOME:-$HOME/.local/share}/waylandie/game-profiles"
PROFILE_DIR="$PROFILES_ROOT/$PROFILE"
if [ -d "$PROFILE_DIR" ]; then
    if [ -f "$PROFILE_DIR/env.sh" ]; then
        echo "Loading profile '$PROFILE'…"
        . "$PROFILE_DIR/env.sh"
    fi
    if [ -L "$PROFILE_DIR/dxvk" ] && [ "$DXVK" != "off" ]; then
        DXVK_DIR=$(readlink -f "$PROFILE_DIR/dxvk")
        if [ -d "$DXVK_DIR" ]; then
            export WINEDLLOVERRIDES="${WINEDLLOVERRIDES:-}d3d9,d3d10core,d3d11,dxgi=native;"
            export DXVK_CONFIG_FILE="${DXVK_CONFIG_FILE:-$DXVK_DIR/dxvk.conf}"
            export LD_LIBRARY_PATH="$DXVK_DIR/x32:$DXVK_DIR/x64:${LD_LIBRARY_PATH:-}"
            DXVK=on
            echo "  DXVK: $DXVK_DIR"
        fi
    fi
    if [ -L "$PROFILE_DIR/turnip" ]; then
        TURNIP_DIR=$(readlink -f "$PROFILE_DIR/turnip")
        ICD=$(find "$TURNIP_DIR" -name "*icd*.json" -type f 2>/dev/null | head -1)
        if [ -n "$ICD" ]; then
            export VK_ICD_FILENAMES="$ICD${VK_ICD_FILENAMES:+:$VK_ICD_FILENAMES}"
            echo "  Turnip ICD: $ICD"
        fi
    fi
    if [ -L "$PROFILE_DIR/qcom-adreno" ]; then
        QCOM_DIR=$(readlink -f "$PROFILE_DIR/qcom-adreno")
        ICD=$(find "$QCOM_DIR" -name "*icd*.json" -type f 2>/dev/null | head -1)
        if [ -n "$ICD" ]; then
            export VK_ICD_FILENAMES="$ICD${VK_ICD_FILENAMES:+:$VK_ICD_FILENAMES}"
            echo "  Qualcomm Adreno ICD: $ICD"
        fi
    fi
    if [ -L "$PROFILE_DIR/fex" ]; then
        FEX_DIR=$(readlink -f "$PROFILE_DIR/fex")
        if [ -d "$FEX_DIR" ]; then
            export FEX_ROOT="$FEX_DIR"
            export PATH="$FEX_DIR/bin:$PATH"
            FEX=true
            echo "  FEX-Emu: $FEX_DIR"
        fi
    fi
fi

# ---------------------------------------------------------------------
# Set WINEPREFIX.
# ---------------------------------------------------------------------
mkdir -p "$WINEPREFIX_DIR"
export WINEPREFIX="$WINEPREFIX_DIR"

# ---------------------------------------------------------------------
# Build the final command.
# ---------------------------------------------------------------------
# FEX-Emu wraps the entire wine invocation for x86 binaries on arm64.
FEX_PREFIX=""
if [ "$FEX" = "true" ] && command -v FEXLoader >/dev/null 2>&1; then
    FEX_PREFIX="FEXLoader --"
    echo "FEX-Emu wrapping enabled."
fi

# box86 / box64 wrap wine-stable (the i386 binary) for x86 games.
BOX86_PREFIX=""
if [ "$BOX86" = "true" ] && command -v box86 >/dev/null 2>&1; then
    BOX86_PREFIX="box86"
    echo "box86 wrapping enabled."
fi
BOX64_PREFIX=""
if [ "$BOX64" = "true" ] && command -v box64 >/dev/null 2>&1; then
    BOX64_PREFIX="box64"
    echo "box64 wrapping enabled."
fi

# gamescope wraps everything if requested.
GAMESCOPE_PREFIX=""
if [ "$GAMESCOPE" = "true" ] && command -v gamescope >/dev/null 2>&1; then
    GAMESCOPE_PREFIX="gamescope -W 1280 -H 720 -r 60 --"
    echo "gamescope wrapping enabled (1280x720@60)."
elif [ "$GAMESCOPE" = "true" ]; then
    echo "WARNING: --gamescope requested but gamescope not installed." >&2
fi

# ---------------------------------------------------------------------
# Print summary + exec.
# ---------------------------------------------------------------------
echo
echo "=== WayLandIE game launch ==="
echo "  exe       : $REAL_EXE"
echo "  profile   : $PROFILE"
echo "  wine      : $WINE_BIN"
echo "  wineprefix: $WINEPREFIX"
echo "  dxvk      : $DXVK"
echo "  fex       : $FEX"
echo "  box86/64  : $BOX86 / $BOX64"
echo "  gamescope : $GAMESCOPE"
echo "  socket    : $WAYLANDIE_BRIDGE_SOCKET"
echo "  finalcopy : $WAYLANDIE_FINAL_COPY"
echo "  extra args: ${EXTRA_ARGS[*]:-(none)}"
echo

# shellcheck disable=SC2086
exec $GAMESCOPE_PREFIX $BOX64_PREFIX $BOX86_PREFIX $FEX_PREFIX \
    "$WINE_BIN" "$REAL_EXE" "${EXTRA_ARGS[@]}"
