#!/bin/bash
# waylandie-install-driver — unified driver/wrapper installer for the
# rootfs (bionic) environment.
#
# Supports:
#   turnip       Mesa Turnip KGSL bionic variant (.zip or .tar.gz)
#                Standalone variant (links against libhardware.so) is
#                REJECTED because it crashes with SIGTRAP in bionic.
#   dxvk         Armec DXVK (bionic) — .tar.gz, .zip, or .wcp
#   proton       Armec Proton (bionic) — .tar.gz or .wcp
#                (.wcp = Winlator Container Package; auto-detected by
#                magic bytes, not extension. Internal layout may differ
#                from Armec — caller should verify after extraction.)
#   fex          FEX-Emu rootfs (.tar.xz or .wcp)
#   qcom-adreno  Qualcomm proprietary driver (.deb) — kept for compat
#   box86        box86 binary release (.tar.gz)
#   box64        box64 binary release (.tar.gz)
#
# Usage:
#   waylandie-install-driver --kind KIND --slot NAME --file PATH [--activate]
#   waylandie-install-driver --list --file PATH
#
# The --list mode prints the archive's contents without extracting.
# Useful for diagnosing layout mismatches (e.g. Winlator .wcp packages
# that have a different internal structure than Armec packages).
#
# The slot is installed under:
#   $PREFIX/share/waylandie/driver-slots/KIND/SLOT/
#
# If --activate is passed, an env file is written at:
#   $PREFIX/share/waylandie/env-KIND.sh
# which waylandie-bundled rootfs sources automatically.

set -e

KIND=""
SLOT=""
FILE=""
ACTIVATE=false
LIST_ONLY=false

while [ $# -gt 0 ]; do
    case "$1" in
        --kind)     KIND="$2"; shift 2 ;;
        --slot)     SLOT="$2"; shift 2 ;;
        --file)     FILE="$2"; shift 2 ;;
        --activate) ACTIVATE=true; shift ;;
        --list)     LIST_ONLY=true; shift ;;
        *)          echo "unknown arg: $1" >&2; exit 2 ;;
    esac
done

[ -z "$FILE" ] && { echo "--file required" >&2; exit 2; }

if [ "$LIST_ONLY" = "true" ]; then
    # Resolve file path
    for candidate in \
        "$FILE" \
        "/usr/local/share/waylandie/driver-archive/$(basename "$FILE")" \
        "/sdcard/Download/$(basename "$FILE")" \
        "/sdcard/Download/WayLandIE/drivers/$(basename "$FILE")" \
        "/storage/emulated/0/Download/$(basename "$FILE")" \
        "$HOME/storage/downloads/$(basename "$FILE")"; do
        if [ -f "$candidate" ]; then
            FILE="$candidate"
            break
        fi
    done
    if [ ! -f "$FILE" ]; then
        echo "ERROR: file not found: $FILE" >&2
        exit 1
    fi
    echo "=== Archive: $FILE ==="
    echo "Size: $(stat -c%s "$FILE") bytes"
    echo "Magic: $(head -c 4 "$FILE" | od -An -tx1 | tr -d ' ')"
    echo ""
    echo "=== Detection ==="
    detect_archive_type "$FILE"
    echo ""
    echo "=== Contents (first 100 entries) ==="
    list_archive_contents "$FILE" | head -100
    exit 0
fi

[ -z "$KIND" ] && { echo "--kind required" >&2; exit 2; }
[ -z "$SLOT" ] && { echo "--slot required" >&2; exit 2; }

case "$KIND" in
    turnip|dxvk|proton|fex|qcom-adreno|box86|box64) ;;
    *) echo "unknown kind: $KIND" >&2; exit 2 ;;
esac

# ---------------------------------------------------------------------
# Archive format detection helpers
# ---------------------------------------------------------------------
# These detect format by MAGIC BYTES, not by file extension. This lets
# us handle .wcp (Winlator Container Package) files, which are typically
# gzip-compressed tar archives with a non-standard extension. Also
# handles .deb, plain tar, zip, xz, and bzip2.
#
# Magic byte references:
#   1f 8b         → gzip (tar.gz, .wcp, .tgz)
#   42 5a 68      → bzip2 (tar.bz2, .tbz2)
#   fd 37 7a 58 5a → xz (tar.xz, .txz)
#   50 4b 03 04   → zip (.zip, .jar, .apk)
#   21 3c 61 72 63→ ar archive (.deb)
#   75 73 74 61 72 → ustar (plain tar, at offset 257)

detect_archive_type() {
    local f="$1"
    local magic
    magic=$(head -c 6 "$f" 2>/dev/null | od -An -tx1 | tr -d ' \n')
    case "$magic" in
        1f8b*)          echo "gzip" ;;
        425a68*)        echo "bzip2" ;;
        fd377a585a00*)  echo "xz" ;;
        504b0304*)      echo "zip" ;;
        213c61726368*)  echo "ar-deb" ;;
        *)
            # Check for ustar magic at offset 257 (plain tar)
            if head -c 264 "$f" 2>/dev/null | tail -c 5 | grep -q "^ustar"; then
                echo "tar"
            else
                echo "unknown"
            fi
            ;;
    esac
}

list_archive_contents() {
    local f="$1"
    local type
    type=$(detect_archive_type "$f")
    case "$type" in
        gzip)   tar -tzf "$f" 2>/dev/null ;;
        bzip2)  tar -tjf "$f" 2>/dev/null ;;
        xz)     tar -tJf "$f" 2>/dev/null ;;
        tar)    tar -tf "$f" 2>/dev/null ;;
        zip)    unzip -l "$f" 2>/dev/null | awk 'NR>3 && $4 != "" {print $4}' ;;
        ar-deb) ar t "$f" 2>/dev/null ;;
        *)
            echo "  (unknown archive type, magic=$(head -c 4 "$f" | od -An -tx1 | tr -d ' '))" >&2
            # Try tar then zip as last resort
            tar -tf "$f" 2>/dev/null || unzip -l "$f" 2>/dev/null | awk 'NR>3 && $4 != "" {print $4}'
            ;;
    esac
}

extract_archive() {
    # extract_archive <archive> <dest_dir>
    local f="$1"
    local dest="$2"
    local type
    type=$(detect_archive_type "$f")
    echo "Detected archive type: $type"
    case "$type" in
        gzip)   tar -xzf "$f" -C "$dest" ;;
        bzip2)  tar -xjf "$f" -C "$dest" ;;
        xz)     tar -xJf "$f" -C "$dest" ;;
        tar)    tar -xf "$f" -C "$dest" ;;
        zip)    unzip -q "$f" -d "$dest" ;;
        ar-deb)
            local tmp
            tmp=$(mktemp -d)
            cp "$f" "$tmp/pkg.deb"
            (cd "$tmp" && ar x pkg.deb && tar -xf data.tar.* -C "$dest" 2>/dev/null || true)
            rm -rf "$tmp"
            ;;
        *)
            echo "ERROR: unrecognized archive format (magic=$(head -c 4 "$f" | od -An -tx1 | tr -d ' '))" >&2
            echo "  Tried gzip, bzip2, xz, tar, zip, deb." >&2
            echo "  If this is a Winlator .wcp file, it should be gzip-compressed." >&2
            echo "  If it's a different format, send the magic bytes above for support." >&2
            return 1
            ;;
    esac
}

PREFIX="${WAYLANDIE_PREFIX:-/usr/local}"

# Resolve file path
RESOLVED_FILE=""
for candidate in \
    "$FILE" \
    "$PREFIX/share/waylandie/driver-archive/$(basename "$FILE")" \
    "/sdcard/Download/$(basename "$FILE")" \
    "/sdcard/Download/WayLandIE/drivers/$(basename "$FILE")" \
    "/storage/emulated/0/Download/$(basename "$FILE")" \
    "$HOME/storage/downloads/$(basename "$FILE")"; do
    if [ -f "$candidate" ]; then
        RESOLVED_FILE="$candidate"
        break
    fi
done
if [ -z "$RESOLVED_FILE" ]; then
    echo "ERROR: file not found. Tried:" >&2
    echo "  $FILE" >&2
    echo "  $PREFIX/share/waylandie/driver-archive/$(basename "$FILE")" >&2
    echo "  /sdcard/Download/$(basename "$FILE")" >&2
    echo "  /storage/emulated/0/Download/$(basename "$FILE")" >&2
    exit 1
fi
FILE="$RESOLVED_FILE"
echo "Resolved archive to: $FILE"

# Install root
SLOTS_ROOT="$PREFIX/share/waylandie/driver-slots"
SLOT_DIR="$SLOTS_ROOT/$KIND/$SLOT"
mkdir -p "$SLOT_DIR"
rm -rf "$SLOT_DIR"/*
echo "Installing $KIND slot '$SLOT' → $SLOT_DIR"

# ---------------------------------------------------------------------
# Extract — uses magic-byte detection so .wcp / .tar.gz / .zip / .deb
# all work regardless of file extension.
# ---------------------------------------------------------------------
extract_archive "$FILE" "$SLOT_DIR" || {
    echo "ERROR: extraction failed." >&2
    echo "  Archive: $FILE" >&2
    echo "  Detected type: $(detect_archive_type "$FILE")" >&2
    echo "  Slot dir: $SLOT_DIR" >&2
    echo "" >&2
    echo "  First 20 entries in archive:" >&2
    list_archive_contents "$FILE" 2>/dev/null | head -20 >&2
    exit 1
}
echo "Extraction complete."
echo "Top-level contents of slot dir:"
ls -la "$SLOT_DIR" 2>/dev/null | head -20

# ---------------------------------------------------------------------
# Kind-specific validation + install
# ---------------------------------------------------------------------
case "$KIND" in
    turnip)
        # Find the .so
        SO=$(find "$SLOT_DIR" -name "libvulkan_freedreno.so" -type f 2>/dev/null | head -1)
        if [ -z "$SO" ]; then
            echo "ERROR: no libvulkan_freedreno.so in archive." >&2
            find "$SLOT_DIR" -type f | head -10
            exit 1
        fi
        echo "  Found .so: $SO"

        # CRITICAL: validate this is the KGSL bionic variant, NOT standalone.
        # Standalone links against libhardware.so, libsync.so, libcutils.so —
        # all of which are bionic framework libs that cause SIGTRAP crashes
        # in the bundled rootfs-native environment.
        if strings "$SO" 2>/dev/null | grep -qi "libhardware\|libsync\.so\|libcutils"; then
            echo "ERROR: this Turnip .so is the STANDALONE variant." >&2
            echo >&2
            echo "It links against Android's libhardware.so which crashes" >&2
            echo "with SIGTRAP 'Trace/breakpoint trap' inside bundled rootfs-native" >&2
            echo "(bionic/glibc ABI conflict)." >&2
            echo >&2
            echo "Install the KGSL bionic variant instead. Look for:" >&2
            echo "  - File names containing 'kgsl' or 'mesa-vulkan-kgsl'" >&2
            echo "  - Builds from the bundled rootfs-packages mesa-vulkan-icd-freedreno" >&2
            echo "  - Or builds labeled 'bionic' from Armec or similar" >&2
            echo >&2
            echo "Cleaning up failed install…" >&2
            rm -rf "$SLOT_DIR"
            exit 1
        fi

        # Looks safe — verify it has KGSL symbols
        if strings "$SO" 2>/dev/null | grep -qi "kgsl\|/dev/kgsl"; then
            echo "  KGSL variant detected ✓"
        else
            echo "  WARNING: no KGSL symbols found. May not work." >&2
            echo "  Continuing anyway — test with vulkaninfo." >&2
        fi

        # Install .so to system lib path
        mkdir -p "$PREFIX/lib"
        cp -f "$SO" "$PREFIX/lib/libvulkan_freedreno.so"
        chmod 644 "$PREFIX/lib/libvulkan_freedreno.so"

        # Write ICD JSON with absolute path
        ICD_DIR="$PREFIX/etc/vulkan/icd.d"
        mkdir -p "$ICD_DIR"
        cat > "$ICD_DIR/freedreno_icd.json" <<EOF
{
    "file_format_version": "1.0.0",
    "ICD": {
        "library_path": "$PREFIX/lib/libvulkan_freedreno.so",
        "api_version": "1.3.0"
    }
}
EOF
        echo "  ICD JSON: $ICD_DIR/freedreno_icd.json"

        # Disable llvmpipe ICD if present
        LP_ICD="$PREFIX/etc/vulkan/icd.d/lvp_icd.json"
        if [ -f "$LP_ICD" ]; then
            mv "$LP_ICD" "${LP_ICD}.disabled"
            echo "  Disabled llvmpipe ICD"
        fi

        # Write env file
        if [ "$ACTIVATE" = "true" ]; then
            cat > "$PREFIX/share/waylandie/env-turnip.sh" <<EOF
export VK_ICD_FILENAMES=$ICD_DIR/freedreno_icd.json
export VK_DRIVER_FILES=$ICD_DIR/freedreno_icd.json
EOF
            echo "  Wrote $PREFIX/share/waylandie/env-turnip.sh"
            ln -sfn "$SLOT" "$SLOTS_ROOT/turnip/active"
        fi
        ;;

    dxvk)
        # Find DXVK layout — either x32/x64 dirs at root, or nested
        if [ ! -d "$SLOT_DIR/x32" ] && [ ! -d "$SLOT_DIR/x64" ]; then
            TOP=$(find "$SLOT_DIR" -maxdepth 1 -mindepth 1 -type d | head -1)
            if [ -n "$TOP" ] && { [ -d "$TOP/x32" ] || [ -d "$TOP/x64" ]; }; then
                mv "$TOP"/* "$SLOT_DIR"/ 2>/dev/null || true
                rmdir "$TOP" 2>/dev/null || true
            fi
        fi
        echo "  DXVK at: $SLOT_DIR"

        if [ "$ACTIVATE" = "true" ]; then
            cat > "$PREFIX/share/waylandie/env-dxvk.sh" <<EOF
export DXVK_CONFIG_FILE="${DXVK_CONFIG_FILE:-$SLOT_DIR/dxvk.conf}"
export WINEDLLOVERRIDES="d3d8,d3d9,d3d10core,d3d11,dxgi=native"
export DXVK_STATE_CACHE_PATH="\$HOME/.dxvk-cache-$SLOT"
# Path so wine can find DXVK dlls
export WAYLANDIE_DXVK_DIR="$SLOT_DIR"
EOF
            echo "  Wrote $PREFIX/share/waylandie/env-dxvk.sh"
            ln -sfn "$SLOT" "$SLOTS_ROOT/dxvk/active"
        fi
        ;;

    proton)
        # Armec Proton layout: typically has 'proton' script + 'files/' + 'dist/'
        echo "  Proton at: $SLOT_DIR"
        ls -la "$SLOT_DIR" | head -10

        if [ "$ACTIVATE" = "true" ]; then
            cat > "$PREFIX/share/waylandie/env-proton.sh" <<EOF
export WAYLANDIE_PROTON_DIR="$SLOT_DIR"
export STEAM_COMPAT_CLIENT_INSTALL_PATH="\$HOME/.local/share/Steam"
export STEAM_COMPAT_DATA_PATH="\$HOME/.proton-$SLOT"
# Proton 9+ respects this for skipping pressure-vessel (no namespaces in bundled rootfs)
export STEAM_RUNTIME=0
EOF
            echo "  Wrote $PREFIX/share/waylandie/env-proton.sh"
            ln -sfn "$SLOT" "$SLOTS_ROOT/proton/active"
        fi
        ;;

    fex)
        if [ -d "$SLOT_DIR/bin" ]; then
            echo "  FEX bin: $SLOT_DIR/bin"
        else
            TOP=$(find "$SLOT_DIR" -maxdepth 1 -mindepth 1 -type d | head -1)
            if [ -n "$TOP" ] && [ -d "$TOP/bin" ]; then
                mv "$TOP"/* "$SLOT_DIR"/ 2>/dev/null || true
                rmdir "$TOP" 2>/dev/null || true
            fi
        fi

        if [ "$ACTIVATE" = "true" ]; then
            cat > "$PREFIX/share/waylandie/env-fex.sh" <<EOF
export FEX_ROOT="$SLOT_DIR"
export PATH="$SLOT_DIR/bin:\$PATH"
EOF
            echo "  Wrote $PREFIX/share/waylandie/env-fex.sh"
            ln -sfn "$SLOT" "$SLOTS_ROOT/fex/active"
        fi
        ;;

    qcom-adreno)
        ICD=$(find "$SLOT_DIR" -name "*icd*.json" -type f 2>/dev/null | head -1)
        if [ -n "$ICD" ]; then
            echo "  Qualcomm ICD: $ICD"
            ICD_DIR="$PREFIX/etc/vulkan/icd.d"
            mkdir -p "$ICD_DIR"
            cp -f "$ICD" "$ICD_DIR/"
        fi
        ;;

    box86|box64)
        BIN=$(find "$SLOT_DIR" -name "box86" -o -name "box64" -type f 2>/dev/null | head -1)
        echo "  $KIND binary: ${BIN:-<not found>}"
        if [ -n "$BIN" ] && [ "$ACTIVATE" = "true" ]; then
            mkdir -p "$PREFIX/bin"
            ln -sf "$BIN" "$PREFIX/bin/$KIND"
        fi
        ;;
esac

# Write a meta.json with slot info
cat > "$SLOT_DIR/meta.json" <<EOF
{
    "kind": "$KIND",
    "slot": "$SLOT",
    "installed_from": "$FILE",
    "installed_at": "$(date -u +%Y-%m-%dT%H:%M:%SZ)",
    "activated": $ACTIVATE
}
EOF

echo
echo "Done."
if [ "$ACTIVATE" = "true" ]; then
    echo "Slot '$SLOT' activated as default for $KIND."
    echo "Run waylandie-doctor to verify."
fi
