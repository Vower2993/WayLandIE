#!/bin/sh
# waylandie-audio — manage the PulseAudio audio bridge.
#
# Starts PulseAudio with a TCP sink on port 57392 so the WayLandIE
# Android app can pull audio and play it back via Android AudioTrack
# (OpenSL ES for low latency).
#
# Subcommands:
#   start    — start PulseAudio with the WayLandIE sink
#   stop     — stop PulseAudio
#   status   — show whether PulseAudio is running
#   test     — play a 1-second test tone through the bridge

set -e

ACTION="${1:-status}"

PREFIX="${WAYLANDIE_PREFIX:-/data/data/com.termux/files/usr}"
AUDIO_PORT="${WAYLANDIE_AUDIO_PORT:-57392}"

case "$ACTION" in
    start)
        if pgrep -x pulseaudio >/dev/null 2>&1; then
            echo "PulseAudio already running (pid $(pgrep -x pulseaudio))"
            exit 0
        fi
        if [ ! -x "$PREFIX/bin/pulseaudio" ]; then
            echo "ERROR: pulseaudio not installed." >&2
            echo "  pkg install pulseaudio" >&2
            exit 1
        fi
        echo "Starting PulseAudio with WayLandIE sink on port $AUDIO_PORT …"
        "$PREFIX/bin/pulseaudio" --start \
            --disallow-exit \
            --exit-idle-time=-1 \
            -n \
            --file "$PREFIX/etc/pulse/default.pa" 2>&1 | head -20
        sleep 1
        if pgrep -x pulseaudio >/dev/null 2>&1; then
            echo "PulseAudio running (pid $(pgrep -x pulseaudio))"
            echo "Audio bridge: tcp://127.0.0.1:$AUDIO_PORT"
        else
            echo "ERROR: PulseAudio failed to start." >&2
            exit 1
        fi
        ;;

    stop)
        if pgrep -x pulseaudio >/dev/null 2>&1; then
            "$PREFIX/bin/pulseaudio" --kill 2>/dev/null || pkill -x pulseaudio
            echo "PulseAudio stopped"
        else
            echo "PulseAudio not running"
        fi
        ;;

    status)
        if pgrep -x pulseaudio >/dev/null 2>&1; then
            echo "status=running pid=$(pgrep -x pulseaudio)"
            echo "audio_bridge=tcp://127.0.0.1:$AUDIO_PORT"
        else
            echo "status=stopped"
        fi
        ;;

    test)
        if ! pgrep -x pulseaudio >/dev/null 2>&1; then
            echo "PulseAudio not running. Start with: waylandie-audio start"
            exit 1
        fi
        if command -v pacat >/dev/null 2>&1; then
            echo "Playing 2-second 440Hz sine wave through bridge…"
            # Generate a 2-second 440Hz sine wave and stream it
            python3 -c "
import struct, math, sys
RATE = 44100
FREQ = 440
DUR = 2
for i in range(RATE * DUR):
    sample = int(32767 * math.sin(2 * math.pi * FREQ * i / RATE))
    sys.stdout.buffer.write(struct.pack('<h', sample))
" 2>/dev/null | pacat -p waylandie_out --rate=44100 --format=s16le
        else
            echo "pacat not installed. Install pulseaudio-utils to test."
        fi
        ;;

    *)
        echo "usage: $0 {start|stop|status|test}" >&2
        exit 2
        ;;
esac
