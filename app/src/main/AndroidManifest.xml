<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Network: required because the bridge socket can also be exposed on TCP
         for remote debugging (off by default). -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Foreground service keeps the Wayland bridge alive while the user is
         inside Termux / proot / Steam. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <!-- Required to post the keep-alive notification on Android 13+. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Wake lock: optional, used to prevent the display from going to sleep
         while a game is running. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Legacy perms for Android 12 and earlier. Ignored on 13+. -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <!-- MANAGE_EXTERNAL_STORAGE: needed on Android 13+ so the bundled
         proot rootfs can access /sdcard for game .exe files. -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />

    <!-- No Termux queries needed — everything is self-contained. -->

    <application
        android:allowBackup="false"
        android:appCategory="game"
        android:debuggable="false"
        android:hasFragileUserData="true"
        android:label="@string/app_name"
        android:icon="@drawable/ic_bridge"
        android:roundIcon="@drawable/ic_bridge"
        android:supportsRtl="true"
        android:theme="@style/AppTheme"
        android:requestLegacyExternalStorage="false">

        <!-- Launcher entry point: first-run environment extractor.
             If the bundled rootfs isn't installed yet, this extracts it
             with a progress bar. If already installed, it immediately
             forwards to HomeActivity. -->
        <activity
            android:name=".runtime.environment.EnvironmentInitializer"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:theme="@style/AppTheme">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Home screen (shown after environment is ready) -->
        <activity
            android:name=".HomeActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:theme="@style/AppTheme" />

        <!-- Original Wayland presenter activity. Started by the bridge when a
             Linux client connects. Keeps the original entry point so existing
             Linux-runtime scripts keep working. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
            android:launchMode="singleTask"
            android:screenOrientation="landscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
            </intent-filter>
        </activity>

        <!-- Multi-window Linux client presenter. -->
        <activity
            android:name=".LinuxWindowActivity"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
            android:exported="false"
            android:resizeableActivity="true"
            android:theme="@style/WindowAppTheme" />

        <!-- First-run setup wizard. Walks the user through installing Termux,
             proot-distro, Debian, then running waylandie install. -->
        <activity
            android:name=".SetupWizardActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/AppTheme" />

        <!-- Settings — central hub for driver/wrapper install + toggle. -->
        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/AppTheme" />

        <!-- Legacy game launcher — kept for backward compat but not
             reachable from the new home screen. -->
        <activity
            android:name=".GameLauncherActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/AppTheme" />

        <!-- Legacy driver installer — kept for backward compat but
             superseded by SettingsActivity. -->
        <activity
            android:name=".DriverInstallerActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/AppTheme" />

        <!-- FileProvider so we can share bundled installer scripts to Termux
             via content:// URIs (Termux can read content URIs). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <service
            android:name=".BridgeKeepAliveService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
    </application>
</manifest>
